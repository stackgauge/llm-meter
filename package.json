{
  "name": "@stackgauge/llm-meter",
  "version": "0.1.0",
  "description": "Meter LLM token usage across OpenAI, Anthropic & Gemini — record per-call usage and compare latest vs previous. Zero-dependency CLI.",
  "keywords": [
    "llm",
    "tokens",
    "token-usage",
    "openai",
    "anthropic",
    "gemini",
    "cost",
    "usage",
    "cli",
    "metering"
  ],
  "license": "MIT",
  "author": "Sandip Gami",
  "contributors": [
    "Sandip Gami"
  ],
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackgauge/llm-meter.git"
  },
  "bugs": {
    "url": "https://github.com/stackgauge/llm-meter/issues"
  },
  "homepage": "https://github.com/stackgauge/llm-meter#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "llm-meter": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
